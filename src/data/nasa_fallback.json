{
  "metadata": {
    "description": "Curated real NASA DONKI space weather events and RAD surface radiation data for fallback use when live API is unavailable.",
    "sources": [
      {
        "name": "NASA DONKI (Space Weather Database Of Notifications, Knowledge, Information)",
        "url": "https://api.nasa.gov/DONKI/",
        "accessed": "2024"
      },
      {
        "name": "Curiosity RAD (Radiation Assessment Detector) - Mars Surface Radiation",
        "url": "https://pds-atmospheres.nmsu.edu",
        "reference": "Hassler et al. (2014), Science 343, doi:10.1126/science.1244797"
      },
      {
        "name": "LRO (Lunar Reconnaissance Orbiter) South Pole Temperature Data",
        "url": "https://svs.gsfc.nasa.gov",
        "reference": "NASA Scientific Visualization Studio"
      }
    ]
  },

  "radiation_constants": {
    "mars_surface_baseline_mSv_per_sol": 0.64,
    "mars_transit_mSv_per_day": 1.84,
    "lunar_surface_baseline_mSv_per_sol": 0.38,
    "nasa_career_limit_mSv": 600,
    "iss_daily_average_mSv": 1.0,
    "note": "Mars surface GCR baseline from Curiosity RAD instrument. Lunar baseline from LRO CRaTER instrument."
  },

  "environmental_constants": {
    "mars": {
      "sol_length_hours": 24.65,
      "sol_length_display": "24 hours, 39 minutes",
      "surface_temp_day_celsius": -15,
      "surface_temp_night_celsius": -80,
      "atmosphere_co2_percent": 95,
      "atmosphere_pressure_pascals": 650,
      "comm_delay_min_minutes": 4,
      "comm_delay_max_minutes": 24,
      "comm_delay_display": "4 to 24 minutes one-way"
    },
    "moon": {
      "sol_length_hours": 708,
      "surface_temp_sunlit_celsius": 20,
      "surface_temp_shadow_celsius": -200,
      "surface_temp_psr_celsius": -240,
      "comm_delay_seconds": 1.3,
      "comm_delay_display": "1.3 seconds one-way",
      "sunlight_at_south_pole_percent": 85
    }
  },

